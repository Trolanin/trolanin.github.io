{
  "manifest_version": 2,
  "name": "Drift for YouTube",
  "version": "0.1.0",
  "description": "Replaces the YouTube picture with Drift, an evolving visualizer that reacts to the video's sound. Can hold the video at 144p to save data while it plays.",
  "homepage_url": "https://github.com/Trolanin/trolanin.github.io/tree/main/drift-viz",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["storage", "*://www.youtube.com/*"],
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_title": "Drift for YouTube",
    "default_icon": "icon.svg",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "toggle-visualizer": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Turn the visualizer on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content/params.js", "content/evolve.js", "content/audio.js", "content/render.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "drift-viz@trolanin.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
